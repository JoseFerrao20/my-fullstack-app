# DOMAIN is e.g. tasks.example.com, or <server-ip-with-dashes>.sslip.io until you have a domain.
# Caddy gets and renews the HTTPS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# The frontend's nginx serves the app and forwards /api to the backend.
	# Caddy replaces any client-sent X-Forwarded-For, so rate limits see the real client IP.
	reverse_proxy frontend:80
}
