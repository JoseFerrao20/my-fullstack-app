# Production settings. On the server: cp .env.production.example .env.production, fill it in,
# then: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Keep .env.production private (it's gitignored). See docs/deploy.md.

# --- Address --------------------------------------------------------------------
# No domain yet? Use the server's IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
# (it resolves to that IP, so HTTPS works). With a domain: tasks.example.com
DOMAIN=

# --- Secrets ---------------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_USER=taskapp
POSTGRES_DB=taskapp

# --- Email (e.g. Brevo: Settings > SMTP & API) -------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Must be a sender address verified in your e-mail provider
MAIL_FROM="Task Manager <tasks@example.com>"

# --- Browser push (optional) -------------------------------------------------------
# Generate with: docker compose -f docker-compose.prod.yml run --rm --no-deps backend python -m app.core.push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
