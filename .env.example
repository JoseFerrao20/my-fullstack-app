# Copy to .env and adjust. docker-compose reads this file automatically.
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=taskapp
POSTGRES_DB=taskapp

# Used by the backend (inside docker-compose the host is "db"; locally use localhost)
DATABASE_URL=postgresql+psycopg://taskapp:taskapp@localhost:5432/taskapp
TEST_DATABASE_URL=postgresql+psycopg://taskapp:taskapp@localhost:5432/taskapp_test

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Outgoing email. docker-compose defaults to the Mailpit container (inbox: http://localhost:8025),
# so leave SMTP_HOST unset there. Running the backend outside Docker? Use the published port:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
MAIL_FROM="Task Manager <no-reply@taskmanager.local>"
# Public URL of the frontend, used for links in emails
APP_BASE_URL=http://localhost

# Web Push (browser notifications). Generate a key pair with:
#   docker compose run --rm backend python -m app.core.push
# Leave empty to turn push off. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taskmanager.local
